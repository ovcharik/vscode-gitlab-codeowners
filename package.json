{
  "name": "vscode-gitlab-codeowners",
  "displayName": "GitLab CODEOWNERS",
  "version": "0.1.0",
  "description": "Syntax highlighting and code owners info for GitLab CODEOWNERS files",
  "categories": [
    "Linters",
    "Programming Languages",
    "SCM Providers"
  ],
  "keywords": [
    "code owners",
    "codeowners",
    "gitlab"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ovcharik/vscode-gitlab-codeowners"
  },
  "publisher": "ovcharik",
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && vite build",
    "watch:vite": "vite build --watch",
    "watch:tsc": "tsc --noEmit --watch",
    "package": "npm run check-types && vite build",
    "check-types": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/vscode": "^1.85.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "gitlab-codeowners.showOwners",
        "title": "GitLab CODEOWNERS: Show owners of current file"
      },
      {
        "command": "gitlab-codeowners.searchByOwner",
        "title": "GitLab CODEOWNERS: Search files by owner"
      }
    ],
    "languages": [
      {
        "id": "codeowners",
        "aliases": [
          "CODEOWNERS",
          "Code Owners"
        ],
        "filenames": [
          "CODEOWNERS"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "codeowners",
        "scopeName": "text.codeowners.gitlab",
        "path": "./syntaxes/codeowners.tmLanguage.json"
      }
    ]
  },
  "activationEvents": [
    "workspaceContains:**/CODEOWNERS"
  ],
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  }
}
