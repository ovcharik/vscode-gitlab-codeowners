{
  "name": "vscode-gitlab-codeowners",
  "displayName": "GitLab CODEOWNERS",
  "description": "Syntax highlighting and code owners info for GitLab CODEOWNERS files",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "ovcharik",
  "repository": {
    "type": "git",
    "url": "https://github.com/ovcharik/vscode-gitlab-codeowners"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "gitlab",
    "codeowners",
    "code owners"
  ],
  "activationEvents": [
    "workspaceContains:**/CODEOWNERS"
  ],
  "main": "./dist/extension.js",
  "icon": "media/icon.png",
  "contributes": {
    "commands": [
      {
        "command": "gitlab-codeowners.showOwners",
        "title": "GitLab CODEOWNERS: Show owners of current file"
      }
    ],
    "languages": [
      {
        "id": "codeowners",
        "aliases": [
          "CODEOWNERS",
          "Code Owners"
        ],
        "filenames": [
          "CODEOWNERS"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "codeowners",
        "scopeName": "text.codeowners.gitlab",
        "path": "./syntaxes/codeowners.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --sourceMap",
    "package": "npm run check-types && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "test": "node esbuild-test.js && node --test out/lint.test.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.2",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@gitlab/codeowners": "^0.2.8"
  }
}
